// Optimiza lo que exista en /recursos, lo publica en /public/recursos y extrae los fotogramas de scroll.
import { spawnSync } from 'node:child_process'
import { copyFileSync, existsSync, mkdirSync, readdirSync, rmSync, writeFileSync } from 'node:fs'
import { join } from 'node:path'
import instalador from '@ffmpeg-installer/ffmpeg'

const entrada = 'recursos'
const salida = 'public/recursos'
const archivos = existsSync(entrada) ? readdirSync(entrada) : []
const frames = {}
const correr = (args) => spawnSync(instalador.path, ['-y', '-loglevel', 'error', ...args], { encoding: 'utf8' }).status === 0

rmSync(salida, { recursive: true, force: true })
rmSync('public/frames', { recursive: true, force: true })
mkdirSync(salida, { recursive: true })

function extraer(nombre, carpeta, filtro) {
  const destino = `public/frames/${nombre}/${carpeta}`
  mkdirSync(destino, { recursive: true })
  const ok = correr(['-i', join(entrada, `${nombre}.mp4`), '-vf', filtro, '-an', '-c:v', 'libwebp', '-quality', '74', join(destino, '%04d.webp')])
  if (!ok) return 0
  return readdirSync(destino).filter((f) => f.endsWith('.webp')).length
}

for (const nombre of ['hook', 'transformacion']) {
  if (!archivos.includes(`${nombre}.mp4`)) continue
  const total = extraer(nombre, 'd', 'fps=15,scale=1600:-2')
  extraer(nombre, 'm', 'fps=15,crop=ih*0.5:ih,scale=720:-2')
  if (total) frames[nombre] = { total, ext: 'webp' }
}

let videos = 0
let fotos = 0
for (const archivo of archivos) {
  const origen = join(entrada, archivo)
  if (/\.mp4$/i.test(archivo)) {
    const ok = correr(['-i', origen, '-an', '-vf', 'scale=1600:-2', '-c:v', 'libx264', '-crf', '27', '-preset', 'veryfast', '-pix_fmt', 'yuv420p', '-movflags', '+faststart', join(salida, archivo)])
    if (!ok) copyFileSync(origen, join(salida, archivo))
    videos += 1
  } else if (/\.(jpe?g|png|webp)$/i.test(archivo)) {
    const base = archivo.replace(/\.[^.]+$/, '')
    const ok = correr(['-i', origen, '-vf', "scale='min(2000,iw)':-2", '-q:v', '4', join(salida, `${base}.jpg`)])
    if (!ok) copyFileSync(origen, join(salida, `${base}.jpg`))
    fotos += 1
  }
}

writeFileSync('src/frames.json', JSON.stringify(frames, null, 2) + '\n')
console.log(`RECURSOS LISTOS: ${videos} videos, ${fotos} fotos, secuencias: ${Object.keys(frames).join(', ') || 'ninguna'}.`)
